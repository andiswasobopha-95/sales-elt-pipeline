# Copy this file to .env and adjust if needed. Defaults work out of the box.

POSTGRES_USER=sales_user
POSTGRES_PASSWORD=sales_pass
POSTGRES_DB=sales_dw
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Number of synthetic orders to generate on each load run
SYNTHETIC_ORDER_COUNT=500
RANDOM_SEED=42

# Source API (no key required)
FAKE_STORE_API_URL=https://fakestoreapi.com/products
